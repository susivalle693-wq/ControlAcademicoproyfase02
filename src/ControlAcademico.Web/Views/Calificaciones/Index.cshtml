@model IEnumerable<ControlAcademico.Entidades.Calificacion>

@{
    ViewData["Title"] = "Calificaciones";
}

<h2>Calificaciones</h2>
<p><a asp-action="Create" class="btn btn-primary">Registrar calificación</a></p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Estudiante</th>
            <th>Curso</th>
            <th>Nota</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
        <tr>
            <td>@(item.Matricula?.Estudiante?.NombreCompleto)</td>
            <td>@(item.Matricula?.Curso?.Nombre)</td>
            <td>@item.Nota.ToString("0.00")</td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id">Editar</a> |
                <a asp-action="Details" asp-route-id="@item.Id">Detalles</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Eliminar</a>
            </td>
        </tr>
        }
        @if (!Model.Any())
        {
        <tr><td colspan="4" class="text-muted">No hay registros.</td></tr>
        }
    </tbody>
</table>
