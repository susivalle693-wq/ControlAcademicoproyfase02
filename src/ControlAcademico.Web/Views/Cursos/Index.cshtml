@model IEnumerable<ControlAcademico.Entidades.Curso>

@{
    ViewData["Title"] = "Cursos";
}

<h2>Cursos</h2>
<p><a asp-action="Create" class="btn btn-primary">Registrar curso</a></p>

<form asp-action="Index" method="get" class="row g-2 mb-3">
    <div class="col-sm-8 col-md-5">
        <input type="search" name="buscar" value="@ViewBag.Buscar" class="form-control" placeholder="Buscar por código, curso o docente" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-primary">Buscar</button>
        @if (!string.IsNullOrWhiteSpace((string?)ViewBag.Buscar))
        {
            <a asp-action="Index" class="btn btn-secondary">Limpiar</a>
        }
    </div>
</form>


<table class="table table-striped">
    <thead>
        <tr>
            <th>Código</th>
            <th>Curso</th>
            <th>Créditos</th>
            <th>Cupo</th>
            <th>Docente</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
        <tr>
            <td>@item.Codigo</td>
            <td>@item.Nombre</td>
            <td>@item.Creditos</td>
            <td>@item.CupoMaximo</td>
            <td>@(item.Docente?.NombreCompleto)</td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id">Editar</a> |
                <a asp-action="Details" asp-route-id="@item.Id">Detalles</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Eliminar</a>
            </td>
        </tr>
        }
        @if (!Model.Any())
        {
        <tr><td colspan="6" class="text-muted">@(string.IsNullOrWhiteSpace((string?)ViewBag.Buscar) ? "No hay registros." : "No se encontraron resultados para la búsqueda.")</td></tr>
        }
    </tbody>
</table>
