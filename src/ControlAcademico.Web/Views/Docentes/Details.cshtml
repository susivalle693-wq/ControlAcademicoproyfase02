@model ControlAcademico.Entidades.Docente

@{
    ViewData["Title"] = "Detalle de docente";
}

<h2>Detalle de docente</h2>
<hr />
<dl class="row">
    <dt class="col-sm-3">Código de empleado</dt>
    <dd class="col-sm-9">@Model.CodigoEmpleado</dd>
    <dt class="col-sm-3">Nombre</dt>
    <dd class="col-sm-9">@Model.Nombre</dd>
    <dt class="col-sm-3">Apellido</dt>
    <dd class="col-sm-9">@Model.Apellido</dd>
    <dt class="col-sm-3">Correo electrónico</dt>
    <dd class="col-sm-9">@Model.Correo</dd>
    <dt class="col-sm-3">Teléfono</dt>
    <dd class="col-sm-9">@(Model.Telefono ?? "-")</dd>
    <dt class="col-sm-3">Fecha de nacimiento</dt>
    <dd class="col-sm-9">@Model.FechaNacimiento.ToString("dd/MM/yyyy")</dd>
    <dt class="col-sm-3">Especialidad</dt>
    <dd class="col-sm-9">@Model.Especialidad</dd>
</dl>
<a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Editar</a>
<a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
