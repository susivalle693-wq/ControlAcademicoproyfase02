@model ControlAcademico.Entidades.Docente

@{
    ViewData["Title"] = "Editar docente";
}

<h2>Editar docente</h2>
<hr />
<div class="row">
  <div class="col-md-6">
    <div class="card seccion-formulario">
    @* Formulario (pantalla tipo FORMULARIO). novalidate desactiva la validación del navegador para usar jQuery Validation (cliente) y ModelState (servidor); data-guardar deshabilita el botón mientras se envía. *@
    <form asp-action="Edit" asp-route-id="@Model.Id" method="post" novalidate data-guardar>
        @* Muestra los errores generales (por ejemplo, "ya está matriculado en este curso"). *@
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <input type="hidden" asp-for="Id" />
        <div class="mb-3">
            <label asp-for="Nombre" class="form-label"></label>
            <input asp-for="Nombre" class="form-control" />
            <span asp-validation-for="Nombre" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Apellido" class="form-label"></label>
            <input asp-for="Apellido" class="form-control" />
            <span asp-validation-for="Apellido" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Correo" class="form-label"></label>
            <input asp-for="Correo" class="form-control" />
            <span asp-validation-for="Correo" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Especialidad" class="form-label"></label>
            <input asp-for="Especialidad" class="form-control" />
            <span asp-validation-for="Especialidad" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="CodigoEmpleado" class="form-label"></label>
            <input asp-for="CodigoEmpleado" class="form-control" />
            <span asp-validation-for="CodigoEmpleado" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="Telefono" class="form-label"></label>
            <input asp-for="Telefono" placeholder="0000-0000" class="form-control" />
            <span asp-validation-for="Telefono" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="FechaNacimiento" class="form-label"></label>
            <input asp-for="FechaNacimiento" type="date" class="form-control" />
            <span asp-validation-for="FechaNacimiento" class="text-danger"></span>
        </div>
        <button type="submit" class="btn btn-primary"><i class="bi bi-check2-circle"></i> Guardar</button>
        <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
    </form>
    </div>
  </div>
</div>

@* Carga jQuery Validation para mostrar los errores debajo de cada campo sin recargar la página. *@
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}