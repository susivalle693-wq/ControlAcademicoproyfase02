@model IEnumerable<ControlAcademico.Entidades.Docente>

@{
    ViewData["Title"] = "Docentes";
}

@* Encabezado de la pantalla: título y botón para registrar un nuevo elemento (pantalla tipo LISTADO). *@
<div class="barra-herramientas">
    <h2 class="mb-0">Docentes</h2>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Registrar docente</a>
</div>

@* Buscador/filtro: envía los datos por GET; el controlador los pasa al servicio de Negocio, que filtra con LINQ. *@
<form asp-action="Index" method="get" class="row g-2 mb-3">
    <div class="col-sm-8 col-md-5">
        <input type="search" name="buscar" value="@ViewBag.Buscar" class="form-control" placeholder="Buscar por código, nombre, correo o especialidad" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-primary"><i class="bi bi-search"></i> Buscar</button>
        @if (!string.IsNullOrWhiteSpace((string?)ViewBag.Buscar))
        {
            <a asp-action="Index" class="btn btn-secondary">Limpiar</a>
        }
    </div>
</form>

@* Tabla del listado. data-paginar="10" le indica a site.js que muestre 10 filas por página. *@
<div class="tabla-wrap">
    <table class="table align-middle" data-paginar="10">
        <thead>
            <tr>
                <th>Código</th>
                <th>Nombre</th>
                <th>Correo</th>
                <th>Especialidad</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @* Una fila por registro. Los botones de editar, ver y eliminar vienen del parcial _Acciones. *@
            @foreach (var item in Model)
            {
                <tr>
                    <td><strong>@item.CodigoEmpleado</strong></td>
                    <td>@item.NombreCompleto</td>
                    <td>@item.Correo</td>
                    <td>@item.Especialidad</td>
                    <td><partial name="_Acciones" model="new ControlAcademico.Models.AccionesFila(item.Id, item.NombreCompleto)" /></td>
                </tr>
            }
            @* Mensaje cuando no hay registros o la búsqueda no encontró resultados. *@
            @if (!Model.Any())
            {
                <tr><td colspan="5" class="text-muted">@(string.IsNullOrWhiteSpace((string?)ViewBag.Buscar) ? "No hay registros." : "No se encontraron resultados para la búsqueda.")</td></tr>
            }
        </tbody>
    </table>
</div>