@model ControlAcademico.Entidades.Estudiante

@{
    ViewData["Title"] = "Detalle de estudiante";
}

<h2>Detalle de estudiante</h2>
<hr />
<dl class="row">
    <dt class="col-sm-3">Carnet</dt>
    <dd class="col-sm-9">@Model.Carnet</dd>
    <dt class="col-sm-3">Nombre</dt>
    <dd class="col-sm-9">@Model.Nombre</dd>
    <dt class="col-sm-3">Apellido</dt>
    <dd class="col-sm-9">@Model.Apellido</dd>
    <dt class="col-sm-3">Correo electrónico</dt>
    <dd class="col-sm-9">@Model.Correo</dd>
    <dt class="col-sm-3">Fecha de ingreso</dt>
    <dd class="col-sm-9">@Model.FechaIngreso.ToString("dd/MM/yyyy")</dd>
    <dt class="col-sm-3">Teléfono</dt>
    <dd class="col-sm-9">@(Model.Telefono ?? "-")</dd>
    <dt class="col-sm-3">Fecha de nacimiento</dt>
    <dd class="col-sm-9">@Model.FechaNacimiento.ToString("dd/MM/yyyy")</dd>
    <dt class="col-sm-3">Carrera</dt>
    <dd class="col-sm-9">@Model.Carrera</dd>
    <dt class="col-sm-3">Facultad</dt>
    <dd class="col-sm-9">@Model.Facultad</dd>
    <dt class="col-sm-3">Ciclo actual</dt>
    <dd class="col-sm-9">@Model.CicloActual</dd>
    <dt class="col-sm-3">CUM</dt>
    <dd class="col-sm-9">@Model.CUM.ToString("0.00")</dd>
    <dt class="col-sm-3">Estado académico</dt>
    <dd class="col-sm-9">@Model.EstadoAcademico</dd>
    <dt class="col-sm-3">Créditos aprobados</dt>
    <dd class="col-sm-9">@Model.CreditosAprobados</dd>
</dl>
<a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Editar</a>
<a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
