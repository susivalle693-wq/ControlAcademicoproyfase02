@model ControlAcademico.Negocio.DashboardResumen
@{
    ViewData["Title"] = "Inicio";
    var etiquetas = System.Text.Json.JsonSerializer.Serialize(Model.InscritosPorCurso.Select(c => c.Curso));
    var valores = System.Text.Json.JsonSerializer.Serialize(Model.InscritosPorCurso.Select(c => c.Inscritos));
    var tarjetaEstudiantes = new ControlAcademico.Models.TarjetaEstadistica { Titulo = "Estudiantes", Valor = Model.Estudiantes, Icono = "bi-people-fill", Controlador = "Estudiantes", ClaseBorde = "borde-estudiantes" };
    var tarjetaDocentes = new ControlAcademico.Models.TarjetaEstadistica { Titulo = "Docentes", Valor = Model.Docentes, Icono = "bi-person-workspace", Controlador = "Docentes", ClaseBorde = "borde-docentes" };
    var tarjetaCursos = new ControlAcademico.Models.TarjetaEstadistica { Titulo = "Cursos", Valor = Model.Cursos, Icono = "bi-journal-bookmark-fill", Controlador = "Cursos", ClaseBorde = "borde-cursos" };
    var tarjetaMatriculas = new ControlAcademico.Models.TarjetaEstadistica { Titulo = "Matrículas", Valor = Model.Matriculas, Icono = "bi-card-checklist", Controlador = "Matriculas", ClaseBorde = "borde-matriculas" };
}

@* Pantalla PRINCIPAL (dashboard): resumen del sistema con datos reales de la base de datos. *@
<div class="barra-herramientas">
    <div>
        <h2 class="mb-0">Panel de control académico</h2>
        <span class="text-muted">Resumen general del sistema</span>
    </div>
    <a href="/swagger" class="btn btn-outline-primary btn-sm"><i class="bi bi-braces"></i> Servicio web (Swagger)</a>
</div>

@* Cuatro tarjetas de estadística (parcial _TarjetaEstadistica). *@
<div class="row g-3 mb-4">
    <div class="col-6 col-lg-3">
        <partial name="_TarjetaEstadistica" model="tarjetaEstudiantes" />
    </div>
    <div class="col-6 col-lg-3">
        <partial name="_TarjetaEstadistica" model="tarjetaDocentes" />
    </div>
    <div class="col-6 col-lg-3">
        <partial name="_TarjetaEstadistica" model="tarjetaCursos" />
    </div>
    <div class="col-6 col-lg-3">
        <partial name="_TarjetaEstadistica" model="tarjetaMatriculas" />
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-7">
        <div class="card h-100">
            <div class="card-body">
                <h2 class="h5 mb-3"><i class="bi bi-bar-chart-fill text-success me-2"></i>Inscritos por curso</h2>
                @if (!Model.InscritosPorCurso.Any())
                {
                    <p class="text-muted mb-0">Todavía no hay cursos registrados.</p>
                }
                else
                {
                    <div style="position: relative; height: 300px;">
                        @* Gráfica de barras: site.js la dibuja con Chart.js; los datos viajan en los atributos data-*. *@
                        <canvas id="graficaInscritos" data-etiquetas="@etiquetas" data-valores="@valores"></canvas>
                    </div>
                }
            </div>
        </div>
    </div>
    <div class="col-lg-5">
        <div class="card h-100">
            <div class="card-body">
                <h2 class="h5 mb-3"><i class="bi bi-clock-history text-warning me-2"></i>Actividad reciente</h2>
                @if (!Model.ActividadReciente.Any())
                {
                    <p class="text-muted mb-0">Todavía no hay actividad registrada.</p>
                }
                else
                {
                    @* Últimas actividades; se guardan solas cada vez que se crea, edita o elimina algo. *@
                    <ul class="list-group list-group-flush">
                        @foreach (var actividad in Model.ActividadReciente)
                        {
                            <li class="list-group-item px-0">
                                <div>@actividad.Descripcion</div>
                                <small class="text-muted">@actividad.Fecha.ToString("dd/MM/yyyy HH:mm")</small>
                            </li>
                        }
                    </ul>
                }
            </div>
        </div>
    </div>
</div>

@section Librerias {
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
}