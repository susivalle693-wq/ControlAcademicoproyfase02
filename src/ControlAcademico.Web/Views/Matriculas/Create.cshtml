@model ControlAcademico.Entidades.Matricula

@{
    ViewData["Title"] = "Registrar matrícula";
}

<h2>Registrar matrícula</h2>
<hr />
<div class="row">
  <div class="col-md-6">
    <div class="card seccion-formulario">
    @* Formulario (pantalla tipo FORMULARIO). novalidate desactiva la validación del navegador para usar jQuery Validation (cliente) y ModelState (servidor); data-guardar deshabilita el botón mientras se envía. *@
    <form asp-action="Create" method="post" novalidate data-guardar>
        @* Muestra los errores generales (por ejemplo, "ya está matriculado en este curso"). *@
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="mb-3">
            <label asp-for="EstudianteId" class="form-label"></label>
            <select asp-for="EstudianteId" asp-items="ViewBag.Estudiantes" class="form-select"><option value="">Seleccione una opción</option></select>
            <span asp-validation-for="EstudianteId" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="CursoId" class="form-label"></label>
            <select asp-for="CursoId" asp-items="ViewBag.Cursos" class="form-select"><option value="">Seleccione una opción</option></select>
            <span asp-validation-for="CursoId" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="FechaMatricula" class="form-label"></label>
            <input asp-for="FechaMatricula" type="date" class="form-control" />
            <span asp-validation-for="FechaMatricula" class="text-danger"></span>
        </div>
        <button type="submit" class="btn btn-primary"><i class="bi bi-check2-circle"></i> Guardar</button>
        <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
    </form>
    </div>
  </div>
</div>

@* Carga jQuery Validation para mostrar los errores debajo de cada campo sin recargar la página. *@
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}