@* *@
@{
    var controlador = ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty;
    string Activo(string nombre) => string.Equals(controlador, nombre, StringComparison.OrdinalIgnoreCase) ? " active" : string.Empty;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Control Académico</title>
    @* Fuentes Poppins (títulos) e Inter (texto) y Bootstrap Icons desde CDN. *@
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Poppins:wght@500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    @* Bootstrap local y luego nuestros estilos (site.css) para poder sobrescribirlos. *@
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        @* Barra superior fija con íconos; el menú se colapsa en celular. *@
        <nav class="navbar navbar-expand-lg fixed-top barra-superior">
            <div class="container-fluid px-3 px-lg-4">
                <a class="navbar-brand" asp-controller="Home" asp-action="Index"><i class="bi bi-mortarboard-fill"></i> Control Académico</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menuPrincipal"
                        aria-controls="menuPrincipal" aria-expanded="false" aria-label="Mostrar navegación">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="menuPrincipal">
                    <ul class="navbar-nav ms-lg-3 me-auto">
                        <li class="nav-item"><a class="nav-link@(Activo("Home"))" asp-controller="Home" asp-action="Index"><i class="bi bi-speedometer2"></i> Inicio</a></li>
                        <li class="nav-item"><a class="nav-link@(Activo("Estudiantes"))" asp-controller="Estudiantes" asp-action="Index"><i class="bi bi-people"></i> Estudiantes</a></li>
                        <li class="nav-item"><a class="nav-link@(Activo("Docentes"))" asp-controller="Docentes" asp-action="Index"><i class="bi bi-person-workspace"></i> Docentes</a></li>
                        <li class="nav-item"><a class="nav-link@(Activo("Cursos"))" asp-controller="Cursos" asp-action="Index"><i class="bi bi-journal-bookmark"></i> Cursos</a></li>
                        <li class="nav-item"><a class="nav-link@(Activo("Matriculas"))" asp-controller="Matriculas" asp-action="Index"><i class="bi bi-card-checklist"></i> Matrículas</a></li>
                        <li class="nav-item"><a class="nav-link@(Activo("Calificaciones"))" asp-controller="Calificaciones" asp-action="Index"><i class="bi bi-award"></i> Calificaciones</a></li>
                        <li class="nav-item"><a class="nav-link@(Activo("ConsultaEstudiante"))" asp-controller="ConsultaEstudiante" asp-action="Index"><i class="bi bi-search"></i> Consulta</a></li>
                    </ul>
                    <a class="nav-link text-white-50 px-0" href="/swagger"><i class="bi bi-braces"></i> Servicio web</a>
                </div>
            </div>
        </nav>
    </header>

    <div class="container py-4">
        @* Aquí se inserta el contenido de cada página. *@
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="pie">
        <div class="container">&copy; 2026 - Control Académico · Proyecto de Cátedra, Fase 2</div>
    </footer>

    @* Avisos tipo toast (mensajes de éxito o error guardados en TempData). *@
    <partial name="_Mensajes" />
    @* Modal de confirmación que usan todos los botones de eliminar. *@
    <partial name="_ConfirmarEliminar" />

    @* Scripts: jQuery, Bootstrap, secciones opcionales de cada página (Chart.js, validación) y site.js. *@
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Librerias", required: false)
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>