@* Avisos tipo toast: toman los mensajes de TempData["Mensaje"] (éxito) y TempData["Error"] (fallo). *@
<div class="toast-container position-fixed top-0 end-0 p-3 contenedor-toasts" style="margin-top: 64px;">
    @if (TempData["Mensaje"] != null)
    {
        <div class="toast toast-exito" role="status" aria-live="polite" aria-atomic="true" data-auto>
            <div class="d-flex">
                <div class="toast-body"><i class="bi bi-check-circle-fill text-success me-2"></i><strong>Listo.</strong> @TempData["Mensaje"]</div>
                <button type="button" class="btn-close me-2 m-auto" data-bs-dismiss="toast" aria-label="Cerrar"></button>
            </div>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="toast toast-error" role="alert" aria-live="assertive" aria-atomic="true" data-auto>
            <div class="d-flex">
                <div class="toast-body"><i class="bi bi-exclamation-triangle-fill text-danger me-2"></i><strong>No se pudo completar.</strong> @TempData["Error"]</div>
                <button type="button" class="btn-close me-2 m-auto" data-bs-dismiss="toast" aria-label="Cerrar"></button>
            </div>
        </div>
    }
</div>